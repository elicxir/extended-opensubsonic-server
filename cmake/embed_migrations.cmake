# Generates a C++ source holding every migration file as a raw string.
# Inputs: OUT (output path), FILES ("|"-separated list of .sql paths, sorted).
string(REPLACE "|" ";" files "${FILES}")
set(body "")
foreach(f IN LISTS files)
  get_filename_component(name "${f}" NAME)
  string(REGEX MATCH "^([0-9]+)_" _ "${name}")
  if(NOT CMAKE_MATCH_1)
    message(FATAL_ERROR "Migration file name must start with a number: ${name}")
  endif()
  math(EXPR version "${CMAKE_MATCH_1}")
  file(READ "${f}" sql)
  string(APPEND body "    {${version}, \"${name}\", R\"eos_sql(${sql})eos_sql\"},\n")
endforeach()
file(WRITE "${OUT}.tmp"
"// Generated by cmake/embed_migrations.cmake. Do not edit.
#include \"db/migrate.h\"

namespace eos::db {
const std::vector<Migration>& embedded_migrations() {
  static const std::vector<Migration> all = {
${body}  };
  return all;
}
}  // namespace eos::db
")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
